<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
             schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">
  <name>ai_cv_package</name>
  <version>0.0.0</version>
  <description>Lane and curb detection node using morphology, DBSCAN, gap analysis, and ONNX inference for the AgileX LIMO.</description>

  <maintainer email="giulio.cataldo@studio.unibo.it">Giulio Cataldo</maintainer>
  <license>Apache-2.0</license>

  <!-- ROS 2 Dependencies -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>

  <!-- Python Libraries -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <!-- Installed with pip in the Foxy Docker image; no Focal rosdep key exists. -->
  <exec_depend>python3-pip</exec_depend>

  <!-- If using get_package_share_directory -->
  <exec_depend>ament_index_python</exec_depend>

  <!-- Testing -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>

</package>
