# Keep useful scripts under version control, but exclude neural-network
# training images and videos stored alongside them.
/useful_scripts/**/*.jpg
/useful_scripts/**/*.jpeg
/useful_scripts/**/*.png
/useful_scripts/**/*.bmp
/useful_scripts/**/*.tif
/useful_scripts/**/*.tiff
/useful_scripts/**/*.webp
/useful_scripts/**/*.mp4
/useful_scripts/**/*.webm
/useful_scripts/**/*.avi
/useful_scripts/**/*.mov
/useful_scripts/**/*.mkv

# Generated local development artifacts.
**/__pycache__/
**/*.py[cod]
**/.vscode/*.db
/ros2_ws/control_logs/
