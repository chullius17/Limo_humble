# Request
float64[] distance_errors
float64[] angular_errors
float64[] linear_velocities
float64[] angular_velocities
float64[] goal_reach_times    # timestamp [s] from mission start for each goal
int32     n_goals
string    output_dir          # directory where to save the jpgs (e.g. /tmp/mission_plots)
---
# Response
bool     success
string[] output_paths         # paths of generated jpgs
string   message