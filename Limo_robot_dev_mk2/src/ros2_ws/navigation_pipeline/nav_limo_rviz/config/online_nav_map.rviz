Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
        - /LaserScan1
        - /AMCL Particle Cloud1
        - /Localization Map1
        - /Online Nav Map1
        - /Static CV Map1
        - /MetricBEV Combined1
        - /Camera RGB1
        - /CV Obstacles Discretized1
        - /CV Street Discretized1
      Splitter Ratio: 0.5
    Tree Height: 611
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.4
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Update Interval: 0.0
    - Class: rviz_default_plugins/LaserScan
      Color: 255; 0; 0
      Enabled: true
      Name: LaserScan
      Size (m): 0.03
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
      Use Fixed Frame: true
    - Alpha: 1
      Class: nav2_rviz_plugins/ParticleCloud
      Color: 0; 180; 0
      Enabled: true
      Max Arrow Length: 0.3
      Min Arrow Length: 0.02
      Name: AMCL Particle Cloud
      Shape: Arrow (Flat)
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /particle_cloud
      Value: true
    - Alpha: 1.0
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Enabled: true
      Name: Localization Map
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Enabled: true
      Name: Online Nav Map
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /limo/nav_map_package/online/nav_map/combined_grid
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Enabled: false
      Name: Static CV Map
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /limo/nav_map_package/online/maps/cv_map
    - Alpha: 0.85
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Enabled: true
      Name: MetricBEV Combined
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /limo/nav_map_package/online/metric_bev/cost_grid_combined
    - Class: rviz_default_plugins/Image
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /rgb/image_raw
      Max Value: 1.0
      Median window: 5
      Min Value: 0.0
      Name: Camera RGB
      Normalize Range: true
      Transport Hint: raw
    - Class: rviz_default_plugins/Image
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /limo/nav_map_package/online/cv_amcl_debug/discretized_obstacles
      Max Value: 255.0
      Median window: 5
      Min Value: 0.0
      Name: CV Obstacles Discretized
      Normalize Range: false
      Transport Hint: raw
    - Class: rviz_default_plugins/Image
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /limo/nav_map_package/online/cv_amcl_debug/discretized_street
      Max Value: 255.0
      Median window: 5
      Min Value: 0.0
      Name: CV Street Discretized
      Normalize Range: false
      Transport Hint: raw
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
Views:
  Current:
    Class: rviz_default_plugins/TopDownOrtho
    Name: Top Down Ortho
    Scale: 20
Window Geometry:
  Height: 900
  Width: 1400
  X: 40
  Y: 40
